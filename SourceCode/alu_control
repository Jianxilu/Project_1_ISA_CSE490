module alu_control(
  input [1:0] alu_op,
  input [3:0] funct,
  output reg [1:0] alu_ctrl
);
always @(*)
begin
  if(alu_op == 2'b00)
    alu_ctrl = 2'b00;
  else if(alu_op == 2'b01)
    alu_ctrl = 2'b01;
  else if(alu_op == 2'b10)
    alu_ctrl = funct[1:0];
  else
    alu_ctrl = 2'b00;
end
endmodule
